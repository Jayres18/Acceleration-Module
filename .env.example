# Copy to .env for local development. .env itself is not committed.
#
# ── Server-side only — never reaches a browser ────────────────────────────────
#
# Where the Vite dev/preview proxy forwards /api. Read by Node in vite.config.js,
# so an absolute http:// URL is safe here and ONLY here. Origin only: no trailing
# path, no trailing slash — the backend expects the /api prefix to survive.
#
#   http://127.0.0.1:5000          the backend is on this same machine
#   http://parallaxed.local:5000   from your own laptop (preferred — mDNS, so it
#                                  survives a DHCP change)
#   http://192.168.0.232:5000      same, by LAN IP (a lease, not a reservation —
#                                  expect it to move eventually)
LMS_ORIGIN=http://parallaxed.local:5000

# Subpath the module is deployed under. Applied to `npm run build` and
# `npm run preview` only; the dev server stays at the root of its port.
# Must match the module slug and must end in a slash.
BASE_PATH=/acceleration/

# ── Baked into the bundle — anything here ships to every student ─────────────
#
# Leave EMPTY. The API is resolved as the root-relative string /api, which
# inherits the page's scheme and host and is proxied at the server root. Set this
# only if the backend is ever reachable over HTTPS, e.g.
# VITE_API_BASE_URL=https://lms.example.edu/api
VITE_API_BASE_URL=
