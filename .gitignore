# NOTE: "trial version/" is a committed standalone project, not build output, so
# it is deliberately NOT ignored. Its node_modules/ is covered by the rule at the
# top of this file, and its build output is called site/ rather than dist/ —
# a bare "dist/" matches at any depth and would silently untrack it.

# Playwright MCP scratch output from browser-driven verification.
.playwright-mcp/
